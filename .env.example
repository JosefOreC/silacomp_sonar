# Copiar como .env. No guardar contraseñas ni tokens en Git.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=5173
SONAR_PORT=9000
SONAR_DB_PASSWORD=
SONAR_TOKEN=

# Se pueden fijar etiquetas o digest de imágenes antes de un despliegue estable.
SONARQUBE_IMAGE=sonarqube:community
SONAR_SCANNER_IMAGE=sonarsource/sonar-scanner-cli:latest

# Linux: usar los valores de id -u e id -g para los reportes en el repositorio.
LOCAL_UID=1000
LOCAL_GID=1000

